{
  "name": "livestocktrack",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant farm operations platform for poultry, goat, and cattle workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohomedarfath/Livestock.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "firebase:login": "npx firebase-tools login",
    "firebase:use": "npx firebase-tools use --add",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting",
    "serve:firebase": "npm run build && npx firebase-tools emulators:start --only hosting",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext js,jsx,ts,tsx",
    "seed:firebase": "node scripts/seed-firebase-demo.mjs",
    "test:rules": "npx firebase-tools@13 emulators:exec --only firestore --project livestocktrack-rules-test \"node scripts/test-firestore-rules.mjs\""
  },
  "dependencies": {
    "firebase": "^11.6.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^2.5.0",
    "localforage": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^6.0.3",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.1.1"
  }
}
